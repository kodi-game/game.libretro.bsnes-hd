msgctxt "Addon Summary"
msgid "Nintendo - SNES / SFC (bsnes-hd beta)"
msgstr "Nintendo - SNES / SFC (bsnes-hd beta)"

msgctxt "Addon Description"
msgid "bsnes-hd is a fork of bsnes that adds HD video features."
msgstr "bsnes-hd je verze odvozená od bsnes, která přidává funkce HD videa."

