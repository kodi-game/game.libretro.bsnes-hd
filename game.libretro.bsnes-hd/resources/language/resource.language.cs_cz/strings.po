msgid "Non-HD"
msgstr "Bez HD"

msgctxt "#30179"
msgid "Ignore"
msgstr "Ignorovat"

msgctxt "#30180"
msgid "1x Scale"
msgstr "Měřítko 1x"

msgctxt "#30181"
msgid "Defines the amount of neighboring lines used to smooth color gradients that are applied to the frame."
msgstr "Určuje počet sousedních řádků použitých k vyhlazení barevných přechodů aplikovaných na snímek."

msgctxt "#30182"
msgid "Defines the amount of neighboring lines used to smooth window effects, such as iris transitions, shadows or spell effects."
msgstr "Určuje počet sousedních řádků používaných k vyhlazení efektů oken, jako jsou přechody clony, stíny nebo kouzelné efekty."

msgctxt "#30183"
msgid "Enables experimental widescreen functionality."
msgstr "Povolí experimentální funkce širokoúhlého režimu."

msgctxt "#30184"
msgid "Only for Mode 7 scenes"
msgstr "Pouze pro scény Mode 7"

msgctxt "#30185"
msgid "Enable for all scenes"
msgstr "Povolit pro všechny scény"

msgctxt "#30186"
msgid "Defines the content aspect ratio used when Widescreen Mode is enabled."
msgstr "Určuje poměr stran obsahu používaný při zapnutém širokoúhlém režimu."

msgctxt "#30187"
msgid "Determines how Widescreen Mode should be applied to Background Layer 1."
msgstr "Určuje, jak má být širokoúhlý režim použit na vrstvu pozadí 1."

msgctxt "#30188"
msgid "Enable if screen-wide and X position is 0"
msgstr "Povolit při šířce celé obrazovky a pozici X rovné 0"

msgctxt "#30189"
msgid "Enable if screen-wide and XY position is 0"
msgstr "Povolit při šířce celé obrazovky a pozici XY rovné 0"

msgctxt "#30190"
msgid "Enable above line 40"
msgstr "Povolit nad řádkem 40"

msgctxt "#30191"
msgid "Enable below line 40"
msgstr "Povolit pod řádkem 40"

msgctxt "#30192"
msgid "Enable above line 80"
msgstr "Povolit nad řádkem 80"

msgctxt "#30193"
msgid "Enable below line 80"
msgstr "Povolit pod řádkem 80"

msgctxt "#30194"
msgid "Enable above line 120"
msgstr "Povolit nad řádkem 120"

msgctxt "#30195"
msgid "Enable below line 120"
msgstr "Povolit pod řádkem 120"

msgctxt "#30196"
msgid "Enable above line 160"
msgstr "Povolit nad řádkem 160"

msgctxt "#30197"
msgid "Enable below line 160"
msgstr "Povolit pod řádkem 160"

msgctxt "#30198"
msgid "Enable above line 200"
msgstr "Povolit nad řádkem 200"

msgctxt "#30199"
msgid "Enable below line 200"
msgstr "Povolit pod řádkem 200"

msgctxt "#30200"
msgid "Hide lateral 8 pixels"
msgstr "Skrýt 8 postranních pixelů"

msgctxt "#30201"
msgid "Hide lateral 8 black pixels"
msgstr "Skrýt 8 černých postranních pixelů"

msgctxt "#30202"
msgid "Disable widescreen for this layer"
msgstr "Zakázat širokoúhlý režim pro tuto vrstvu"

msgctxt "#30203"
msgid "Hide layer entirely"
msgstr "Skrýt celou vrstvu"

msgctxt "#30204"
msgid "Determines how Widescreen Mode should be applied to Background Layer 2."
msgstr "Určuje, jak má být širokoúhlý režim použit na vrstvu pozadí 2."

msgctxt "#30205"
msgid "Determines how Widescreen Mode should be applied to Background Layer 3."
msgstr "Určuje, jak má být širokoúhlý režim použit na vrstvu pozadí 3."

msgctxt "#30206"
msgid "Determines how Widescreen Mode should be applied to Background Layer 4."
msgstr "Určuje, jak má být širokoúhlý režim použit na vrstvu pozadí 4."

msgctxt "#30207"
msgid "Adjusts how sprites and objects should be rendered when using Widescreen Mode."
msgstr "Upravuje způsob vykreslování spritů a objektů při použití širokoúhlého režimu."

msgctxt "#30208"
msgid "Render when in safe area"
msgstr "Vykreslovat v bezpečné oblasti"

msgctxt "#30209"
msgid "Render anywhere (unsafe)"
msgstr "Vykreslovat kdekoli (mimo bezpečnou oblast)"

msgctxt "#30210"
msgid "Clip at widescreen edges"
msgstr "Oříznout na okrajích širokoúhlého režimu"

msgctxt "#30211"
msgid "Hide sprites entirely"
msgstr "Skrýt sprity úplně"

msgctxt "#30212"
msgid "Specifies when to fill the backgrounds of the widescreen areas with the scanline background colors."
msgstr "Určuje, kdy vyplnit pozadí širokoúhlých oblastí barvami pozadí skenovacích řádků."

msgctxt "#30213"
msgid "Fill if scene is widescreen"
msgstr "Vyplnit, pokud je scéna širokoúhlá"

msgctxt "#30214"
msgid "Always fill"
msgstr "Vždy vyplnit"

msgctxt "#30215"
msgid "Use black background"
msgstr "Použít černé pozadí"

msgctxt "#30216"
msgid "Defines which window effects should be ignored when using Widescreen Mode."
msgstr "Určuje, které efekty oken ignorovat při použití širokoúhlého režimu."

msgctxt "#30217"
msgid "Only 'outside' effects"
msgstr "Pouze efekty „mimo“"

msgctxt "#30218"
msgid "Only 'outside' and 'always' effects"
msgstr "Pouze efekty „mimo“ a „vždy“"

msgctxt "#30219"
msgid "All window effects"
msgstr "Všechny efekty oken"

msgctxt "#30220"
msgid "Defines which fallback x-coordinate should be used when ignoring window effects in Widescreen Mode."
msgstr "Určuje, která záložní souřadnice x se má použít při ignorování efektů oken v širokoúhlém režimu."

msgctxt "#30221"
msgid "128 (Center)"
msgstr "128 (střed)"

msgctxt "#30222"
msgid "Allows to highlight the edges of the widescreen areas in some ways."
msgstr "Umožňuje různými způsoby zvýraznit okraje širokoúhlých oblastí."

msgctxt "#30223"
msgid "Show lines at edges"
msgstr "Zobrazit čáry na okrajích"

msgctxt "#30224"
msgid "Darken areas"
msgstr "Ztmavit oblasti"

msgctxt "#30225"
msgid "If widescreen markers are enabled, this option allows to specify their translucency."
msgstr "Pokud jsou povoleny značky širokoúhlého režimu, umožňuje určit jejich průhlednost."

msgctxt "#30226"
msgid "Extends windowing effects into the widescreen areas at the cost of precision. It is recommended to keep this option disabled, unless needed for widescreen hacks."
msgstr "Rozšíří efekty oken do širokoúhlých oblastí za cenu přesnosti. Doporučujeme ponechat tuto volbu zakázanou, pokud ji nepotřebujete pro širokoúhlé úpravy."
